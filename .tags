!_TAG_PROGRAM_VERSION	6.2.0	//
Gr_dB	radarRangeEquation.m	/^    Gr_dB = 10*log10(radarParams.Gr);$/;"	v
Grid_X	genPlanarArray.m	/^    Grid_X = zeros(size(Grid_Y));$/;"	v
Gt_dB	radarRangeEquation.m	/^    Gt_dB = 10*log10(radarParams.Gt);$/;"	v
NP_dB	radarRangeEquation.m	/^    NP_dB = 10*log10(k * radarParams.T * bandwidth) + radarParams.NF_dB;$/;"	v
PRI	genWaveform.m	/^    PRI = waveformParams.PRI;$/;"	v
Pt_dB	radarRangeEquation.m	/^    Pt_dB = 10*log10(radarParams.Pt);$/;"	v
RCS_dBsm	radarRangeEquation.m	/^    RCS_dBsm = 10*log10(radarParams.RCS);$/;"	v
Rr_dB	radarRangeEquation.m	/^    Rr_dB = 20*log10(radarParams.Rr);$/;"	v
Rt_dB	radarRangeEquation.m	/^    Rt_dB = 20*log10(radarParams.Rt);$/;"	v
SNR_dB	radarRangeEquation.m	/^    SNR_dB = Pt_dB + Gt_dB + Gr_dB + lambda_dB + RCS_dBsm - 30*log10(4*pi) - Rt_dB - Rr_dB - los/;"	v
SNR_linear	propSignal.m	/^    SNR_linear = 10^(SNR_dB \/ 20); $/;"	v
axis_coords	genPlanarArray.m	/^    axis_coords = (0:sideLen-1) * spacing;$/;"	v
bandwidth	radarRangeEquation.m	/^    bandwidth = waveformParams.bandwidth;$/;"	v
c	propSignal.m	/^    c = 3e8;$/;"	v
chanData	driver.m	/^chanData = propSignal(txSig, SNR_dB, radarParams, waveformParams.numPRI);/;"	v
channelNoise	propSignal.m	/^        channelNoise = (randn(totalSamples, numPRI) + ...$/;"	v
delay_samples	propSignal.m	/^    delay_samples = round(delay_sec * radarParams.fs);$/;"	v
delay_sec	propSignal.m	/^    delay_sec = (radarParams.Rt + radarParams.Rr) \/ c;$/;"	v
genPlanarArray	genPlanarArray.m	/^function pos_ENU = genPlanarArray(numChan, spacing)$/;"	f
genWaveform	genWaveform.m	/^function sigMat = genWaveform(fs, waveformParams)$/;"	f
idx	genWaveform.m	/^    idx = t < tau;$/;"	v
k	radarRangeEquation.m	/^    k = 1.380649e-23;$/;"	v
lambda_dB	radarRangeEquation.m	/^    lambda_dB = 20*log10(freq2wavelen(radarParams.fc));$/;"	v
lfm	genWaveform.m	/^        lfm = exp(1j * pi * (waveformParams.bandwidth\/tau) * t_centered.^2);$/;"	v
loss_dB	radarRangeEquation.m	/^    loss_dB = 10*log10(radarParams.loss);$/;"	v
numChan	propSignal.m	/^    numChan = radarParams.numChan;$/;"	v
pos_ENU	genPlanarArray.m	/^    pos_ENU = [Grid_X(:), Grid_Y(:), Grid_Z(:)];$/;"	v
propSignal	propSignal.m	/^function sigMatOut = propSignal(txSig, SNR_dB, radarParams, numPRI)$/;"	f
radarRangeEquation	radarRangeEquation.m	/^function [SNR_dB, NP_dB] = radarRangeEquation(radarParams, waveformParams)$/;"	f
sideLen	genPlanarArray.m	/^    sideLen = sqrt(numChan);$/;"	v
sigMat	genWaveform.m	/^    sigMat = zeros(length(t), 1);$/;"	v
sigMatIdeal	propSignal.m	/^    sigMatIdeal = repmat(sigMatScaled, [1 numPRI]);$/;"	v
sigMatOut	propSignal.m	/^    sigMatOut = zeros([signalSamples, numPRI, numChan]);$/;"	v
sigMatScaled	propSignal.m	/^        sigMatScaled = [zeroPad; sigMatScaled(1:end-delay_samples)];$/;"	v
sigMatScaled	propSignal.m	/^        sigMatScaled = zeros(size(txSig));$/;"	v
sigMatScaled	propSignal.m	/^    sigMatScaled = txSig * SNR_linear;$/;"	v
signalSamples	propSignal.m	/^    signalSamples = size(sigMatScaled, 1);$/;"	v
t	genWaveform.m	/^    t = (0:1\/fs:PRI).';$/;"	v
t_centered	genWaveform.m	/^        t_centered = t_pulse - (tau\/2);$/;"	v
t_pulse	genWaveform.m	/^        t_pulse = t(idx);$/;"	v
tau	genWaveform.m	/^    tau = waveformParams.tau;$/;"	v
totalSamples	propSignal.m	/^        totalSamples = size(sigMatIdeal, 1);$/;"	v
txSig	driver.m	/^txSig = genWaveform(radarParams.fs, waveformParams);$/;"	v
zeroPad	propSignal.m	/^        zeroPad = zeros(delay_samples, 1);$/;"	v
